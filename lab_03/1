-- Таблица поставщиков (100 записей)
CREATE TABLE IF NOT EXISTS suppliers (
    supplier_id SERIAL PRIMARY KEY,
    supplier_name VARCHAR(100),
    contact_person VARCHAR(100),
    rating INT
);

-- Вставка 100 записей (твой вариант с реалистичными названиями)
INSERT INTO suppliers (supplier_name, contact_person, rating)
SELECT 
    (ARRAY['TechTrade', 'Global Parts', 'Oriel LLC', 'FastSupply', 'MetallCom', 'ElectroGroup', 'SpetsTech', 'MashImport', 'PromResurs', 'LogiCo'])[ceil(random()*10)] || '_' || seq,
    (ARRAY['Иванов И.', 'Smit J.', 'Петров А.', 'Сидоров К.', 'Кузнецова М.', 'Васильев Д.', 'Lee C.', 'Brown R.', 'Волкова Е.', 'Новиков П.'])[ceil(random()*10)],
    floor(random() * 5) + 1
FROM generate_series(1, 100) AS seq;

-- Проверка количества записей
SELECT COUNT(*) AS total_suppliers FROM suppliers;

-- Просмотр первых 10 записей для проверки
SELECT * FROM suppliers LIMIT 10;

-- Просмотр распределения по рейтингам
SELECT rating, COUNT(*) FROM suppliers GROUP BY rating ORDER BY rating;
